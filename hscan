#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_PYTHON="${SCRIPT_DIR}/.venv/bin/python"
SCAN="${SCRIPT_DIR}/business/scan.py"
if [ ! -x "${VENV_PYTHON}" ]; then
  echo "Missing venv. Run: ${SCRIPT_DIR}/install.sh" >&2
  exit 1
fi
if [ ! -f "${SCAN}" ]; then
  echo "Missing scan module at ${SCAN}" >&2
  exit 1
fi
exec "${VENV_PYTHON}" "${SCAN}" "$@"
